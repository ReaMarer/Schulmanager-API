# Schulmanager-Zugangsdaten (Datei niemals committen!)
SCHULMANAGER_EMAIL=deine.email@example.com
SCHULMANAGER_PASSWORD=

# Optional: Pfad zur SQLite-Datenbank (Standard: ./hausaufgaben.db)
# SCHULMANAGER_DB=hausaufgaben.db

# Optional: Browser sichtbar starten (0/false fuer Debugging)
SCHULMANAGER_HEADLESS=true

# Nextcloud-WebDAV fuer den Markdown-Export
# Basis-URL des Hausaufgaben-Ordners in der Nextcloud
NEXTCLOUD_DAV_BASE=http://127.0.0.1:8080/remote.php/dav/files/USER/orga_vault/00%20Meta/Hausaufgaben
NEXTCLOUD_USER=USER
NEXTCLOUD_PASSWORD=
# Optional: abweichender Stundenplan
# SCHULMANAGER_STUNDENPLAN=/pfad/zu/stundenplan.json
